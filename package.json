{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test src",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit --types bun",
    "db:generate": "bun --bun node_modules/prisma/build/index.js generate",
    "db:validate": "bun --bun node_modules/prisma/build/index.js validate",
    "db:migrate": "bun --bun node_modules/prisma/build/index.js migrate deploy",
    "admin:create": "bun run scripts/create-admin.ts",
    "super-admin:create": "bun run scripts/create-admin.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@azure/storage-blob": "^12.34.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  }
}
